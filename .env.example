# Copy to .env for local development. .env is git-ignored.
PORT=8080
HOME_LAT=-33.93
HOME_LON=18.45
RADIUS_NM=150
ADSB_BASE_URL=https://opendata.adsb.fi/api/v2
# Optional query circles "lat,lon,nm;lat,lon,nm" (max 5, 250 nm each); unset polls one circle around home.
ADSB_POINTS=
ADSB_POLL_INTERVAL=5s
# Leave empty to disable ships.
AISSTREAM_API_KEY=
AIRCRAFT_EXPIRY=60s
VESSEL_EXPIRY=15m
TRACK_WINDOW=15m
TRACK_MIN_INTERVAL=10s
# Route lookups by callsign; set empty to disable.
ROUTE_API_URL=https://adsb.im/api/0/routeset
# Self-hosted basemap: path to a Protomaps PMTiles extract (see `just basemap`). Empty uses OpenFreeMap.
BASEMAP_PMTILES=
# Aircraft photos from planespotters.net; set empty to disable.
PHOTO_API_URL=https://api.planespotters.net/pub/photos/hex
# Alerts: emergency squawks, military aircraft, and watch-listed hex codes or MMSIs.
# Leave NTFY_URL empty to keep alerts in the UI only.
NTFY_URL=
NTFY_TOKEN=
WATCH_LIST=
ALERT_COOLDOWN=1h
